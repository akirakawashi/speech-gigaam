# Папка модели на сервере, в формате стенда (benchmark-cache/gigaam-trt).
GIGAAM_MODEL_DIR=/path/to/temptest/benchmark-cache/gigaam-trt
# Номер видеокарты для Triton.
GIGAAM_GPU=0
# Порт службы на этой машине (127.0.0.1).
GIGAAM_PORT=8090
# Ядра и память контейнера службы: по 2 ядра на обработчик.
GIGAAM_CPUS=8
GIGAAM_MEMORY=16g
# Обработчики, потоки каждого и очередь сверх них.
GIGAAM_WORKERS=4
GIGAAM_THREADS_PER_WORKER=2
GIGAAM_QUEUE_LIMIT=4
# Пределы запроса.
GIGAAM_REQUEST_TIMEOUT_S=600
GIGAAM_MAX_UPLOAD_MB=200
GIGAAM_MAX_AUDIO_SECONDS=7200
GIGAAM_LOG_LEVEL=INFO
